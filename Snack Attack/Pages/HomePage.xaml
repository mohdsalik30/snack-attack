<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Snack_Attack.Models"
             xmlns:vm="clr-namespace:Snack_Attack.ViewModels"
             x:Class="Snack_Attack.Pages.HomePage"
             Title="Snack Attack"
             x:DataType="vm:HomeViewModel">
    
    <ScrollView>
        <VerticalStackLayout>
            
            <BoxView HeightRequest="10" Color="White"/>

            
            <Grid ColumnDefinitions="*,*">
                <Label Grid.Column="0"
                       Text="Popular items"
                       VerticalOptions="End"
                       FontSize="20"
                       FontAttributes="Bold"
                       Padding="10"/>
            </Grid>

            
            <CollectionView ItemsSource="{Binding Snacks}"
                            Margin="10,10,10,20"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="15" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SnackItem">
                        <Frame CornerRadius="20"
                               Padding="10"
                               Margin="10"
                               BackgroundColor="White">
                            
                            <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                                <HorizontalStackLayout Grid.Row="0"
                                                       Grid.Column="1"
                                                       HorizontalOptions="End"
                                                       Spacing="2">
                                    <Label Text="4.5"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="Black"
                                           VerticalTextAlignment="Center"
                                           Margin="0,-75,0,0"/>
                                    <Image Source="star.png"
                                           HeightRequest="15"
                                           WidthRequest="15"
                                           VerticalOptions="Center"
                                           Margin="0,-75,0,0"/>
                                </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="20">
                                <Image Source="{Binding Image}"
                                       WidthRequest="80"
                                       HeightRequest="80"
                                       Aspect="AspectFill"/>
                                <VerticalStackLayout>
                                    <Label Text="{Binding Name}"
                                           FontAttributes="Bold"
                                           FontSize="18"
                                           Padding="2"/>
                                    <Label Text="{Binding Price, StringFormat='£{0:F2}'}"
                                           FontSize="14"
                                           TextColor="Black"/>
                                           
                                </VerticalStackLayout>
                            </HorizontalStackLayout>
                                <Button Grid.Row="2"
                                        Grid.Column="1"
                                        CornerRadius="22"
                                        Text="View"
                                        FontAttributes="Bold"
                                        BackgroundColor="Gold"
                                        TextColor="Black"
                                        VerticalOptions="End"
                                        HorizontalOptions="End"
                                        Padding="25,0"
                                        Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:HomeViewModel}}, 
                          Path=GoToItemDetailsPageCommand}"
                                        CommandParameter="{Binding .}"/>

                            </Grid>
                            
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>


