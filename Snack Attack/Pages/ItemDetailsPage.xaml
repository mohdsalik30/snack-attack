<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Snack_Attack.Models"
             xmlns:vm="clr-namespace:Snack_Attack.ViewModels"
             x:Class="Snack_Attack.Pages.ItemDetailsPage"
             Title="Item Details"
             x:DataType="vm:ItemDetailsViewModel"> 

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            
            <Grid RowDefinitions="Auto, *"
                  ColumnDefinitions="Auto, *"
                  RowSpacing="10"
                  ColumnSpacing="20">

                <Image Source="{Binding SnackItem.Image}"
                       Grid.Row="0"
                       Grid.Column="0"
                       WidthRequest="120"
                       HeightRequest="120"
                       Aspect="AspectFill"
                       VerticalOptions="Start"
                       HorizontalOptions="Start" />

                <HorizontalStackLayout Grid.Row="0"
                                       Grid.Column="1"
                                       HorizontalOptions="End"
                                       VerticalOptions="Start"
                                       Spacing="2"
                                       Margin="0,0,0,5">
                    <Label Text="4.5"
                           FontSize="14"
                           FontAttributes="Bold"
                           Padding="3"
                           VerticalTextAlignment="Center"/>
                    <Image Source="star.png"
                           HeightRequest="15"
                           WidthRequest="15"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>

                <VerticalStackLayout Grid.Row="1"
                                     Grid.Column="1"
                                     Spacing="10">
                    <Label Text="{Binding SnackItem.Name}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="Black"
                           Margin="0,-80,0,0"/>

                    <Label Text="{Binding SnackItem.Price, StringFormat='Price: £{0:F2}'}"
                           FontSize="16"
                           TextColor="DarkGreen"/>
                </VerticalStackLayout>
            </Grid>
            
            <VerticalStackLayout Spacing="5">
                <Label Text="Description"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="Blue"/>
                <Label Text="{Binding SnackItem.Description}"
                       FontSize="12"
                       LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </VerticalStackLayout>
    </ScrollView>
</ContentPage>
