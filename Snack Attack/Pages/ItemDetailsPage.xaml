<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Snack_Attack.Models"
             xmlns:vm="clr-namespace:Snack_Attack.ViewModels"
             x:Class="Snack_Attack.Pages.ItemDetailsPage"
             Title=""
             x:DataType="vm:ItemDetailsViewModel">

    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                
                <Image Source="{Binding SnackItem.Image}" 
                       WidthRequest="150"
                       HeightRequest="150"/>
                
                <Label Text="{Binding SnackItem.Name}"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Start"
                       LineBreakMode="WordWrap"
                       HorizontalOptions="StartAndExpand" 
                       Margin="0,120,0,0"/>
            </HorizontalStackLayout>
            
       

        </VerticalStackLayout>

    </ScrollView>
        </Grid>
</ContentPage>