<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Snack_Attack.Pages.OrderPlacedPage"
             Title="Checkout">
    <VerticalStackLayout VerticalOptions="Center"
                         HorizontalOptions="Center"
                         Padding="20"
                         Spacing="20">
        <Image x:Name="CheckImage"
               Source="check"
               HeightRequest="200"
               WidthRequest="200"
               HorizontalOptions="Center"
               Margin="38,0,0,0"
               Opacity="0"
               Scale="0"/>
        <Label x:Name="OrderPlaced"
               Text="Order Placed Successfully!"
               FontSize="25"
               FontAttributes="Bold"
               TextColor="Green"
               HorizontalOptions="Center"
               Opacity="0"/>
        <Button x:Name="ReturnHome" 
                Text="Return Home"
                BackgroundColor="Gold"
                TextColor="Black"
                FontAttributes="Bold"
                CornerRadius="20"
                Padding="20, 10"
                HorizontalOptions="Center"
                Scale="0"
                Opacity="0"
                Clicked="ReturnHomeButton_Clicked"/>
    </VerticalStackLayout>
</ContentPage>