<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Snack_Attack.Models"
             xmlns:vm="clr-namespace:Snack_Attack.ViewModels"
             x:Class="Snack_Attack.Pages.AllItemsPage"
             x:DataType="vm:AllItemsViewModel"
             Title="Search for snack">
    
    <Grid RowDefinitions="Auto, *"
          Padding="10">

        
        <SearchBar Grid.Row="0"
                   Placeholder="Search for snack"
                   PlaceholderColor="Black"
                   CancelButtonColor="Black"
                   BackgroundColor="White"
                   HeightRequest="40"
                   TextColor="Black"
                   Text="{Binding SearchTerm, Mode=TwoWay}"
                   SearchCommand="{Binding SearchSnackItemCommand}"
                   TextChanged="SearchBar_TextChanged"/>
                   
        
        <ScrollView Grid.Row="1"
                    Margin="5">
            <VerticalStackLayout>
                <CollectionView ItemsSource="{Binding SnackItems}">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="10"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SnackItem">
                            <Frame CornerRadius="20"
                                   Padding="10"
                                   Margin="5"
                                   BackgroundColor="White">

                                <Grid RowDefinitions="Auto, *, Auto"
                                      ColumnDefinitions="*, Auto">

                                    
                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1"
                                                           HorizontalOptions="End"
                                                           Spacing="2"
                                                           Margin="0,0,0,5">
                                        <Label Text="4.5"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="Black"
                                               VerticalTextAlignment="Center"/>
                                        <Image Source="star.png"
                                               HeightRequest="15"
                                               WidthRequest="15"
                                               VerticalOptions="Center"/>
                                    </HorizontalStackLayout>

                                    
                                    <HorizontalStackLayout Grid.Row="1"
                                                           Grid.ColumnSpan="2"
                                                           Spacing="20">
                                        <Image Source="{Binding Image}"
                                               WidthRequest="80"
                                               HeightRequest="80"
                                               Aspect="AspectFill"/>
                                        <VerticalStackLayout>
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   FontSize="18"
                                                   Padding="2"/>
                                            <Label Text="{Binding Price, StringFormat='£{0:F2}'}"
                                                   FontSize="14"
                                                   TextColor="Black"/>
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>

                                    
                                    <Button Grid.Row="2"
                                            Grid.Column="1"
                                            CornerRadius="22"
                                            Text="View"
                                            FontAttributes="Bold"
                                            BackgroundColor="Gold"
                                            TextColor="Black"
                                            VerticalOptions="End"
                                            HorizontalOptions="End"
                                            Padding="25,0"
                                            Command="{Binding Source={x:RelativeSource AncestorType={x:Type vm:AllItemsViewModel}}, 
                          Path=GoToItemDetailsPageCommand}"
                                            CommandParameter="{Binding .}"/>
                                    
                                    
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
